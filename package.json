{
  "name": "signalk-mcp",
  "version": "0.1.0",
  "description": "Native read-only Signal K MCP gateway using existing Signal K identities",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "BRIEF.md",
    "AGENTS.md"
  ],
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-utility",
    "mcp"
  ],
  "signalk": {
    "displayName": "Signal K MCP",
    "screenshots": [
      "./docs/images/native-plugin-config.jpg"
    ]
  },
  "signalk-plugin-enabled-by-default": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test test/approvals.test.cjs test/security.test.cjs test/capabilities.test.cjs test/history.test.cjs test/notifications.test.cjs",
    "test:integration": "npm run build && node --test --test-force-exit test/integration.test.cjs test/hosting.test.cjs test/production-plugin.test.cjs test/runtime.test.cjs test/notifications-native.test.cjs test/restart.test.cjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:integration",
    "verify:package": "node test/package-smoke.cjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@signalk/server-api": "2.33.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.4",
    "prettier": "^3.8.4",
    "signalk-alert-center": "0.4.1",
    "signalk-server": "2.33.0",
    "signalk-to-influxdb": "1.11.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/arodus/signalk-mcp.git"
  },
  "homepage": "https://github.com/arodus/signalk-mcp",
  "bugs": {
    "url": "https://github.com/arodus/signalk-mcp/issues"
  }
}
